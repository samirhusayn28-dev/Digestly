{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 1 * * *"
    }
  ]
}
