# Groq API Key (Deployed as 'NEWS-API-KEY' on Vercel Environment Variables)
# Access in code strictly via: process.env['NEWS-API-KEY']
NEWS-API-KEY=your_groq_api_key_here

# Firebase Admin Configuration for Firestore serverless writes
FIREBASE_PROJECT_ID=digestly-cbe3c
FIREBASE_CLIENT_EMAIL=your_service_account_email_here
FIREBASE_PRIVATE_KEY="your_service_account_private_key_here"

# Optional Vercel Cron protection secret
CRON_SECRET=your_vercel_cron_secret
